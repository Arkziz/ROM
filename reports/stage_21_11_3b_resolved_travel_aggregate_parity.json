        "travel_not_found",
        "unknown_destination",
        "user_not_found",
        "wrong_owner",
        "already_due",
        "stale_revision"
      ]
    },
    "CONSUMER_PRESENTATION_AND_NOTIFICATION_BOUNDARY": {
      "decision": "Domain owns immutable travel state and transitions. Application service owns commands, Unit of Work, World Graph/Location Catalog/BusyState ports and recovery orchestration. Persistence adapter owns storage. Scheduler triggers recovery. Telegram/map adapters render DTOs and send notifications after commit. Presentation text and keyboards never enter domain/application owners."
    }
