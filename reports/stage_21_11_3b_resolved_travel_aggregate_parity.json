  "resolutions": {
    "START_AND_AVAILABILITY_PIPELINE": {
      "decision": "StartTravel evaluates busy state first, then opens one Unit of Work. Inside it: load account/current location and level; validate source and destination IDs; validate adjacency; validate destination unlock unless destination is city; reject an existing ACTIVE travel; create ACTIVE revision 1 with started_at=UTC now and arrival_at=now+20 seconds; commit once.",
      "reasons": [
        "player_busy",
        "user_not_found",
        "invalid_current_node",
        "unknown_destination",
        "not_adjacent",
        "location_locked",
        "already_travelling"
      ]
    },
    "SINGLE_ACTIVE_AND_BUSY_RESTRICTIONS": {
      "decision": "BusyStatePort is authoritative for incompatible activity. A truthy busy snapshot rejects before mutation as player_busy. The repository and database unique constraint remain the race-safe final guard for one ACTIVE travel per user; constraint collision maps to already_travelling."
    },
    "CANCEL_REVISION_AND_TERMINAL_POLICY": {
      "decision": "Cancel requires travel existence, ownership, ACTIVE state, not-yet-due ETA and matching expected revision. V2 uses expected_revision as required command concurrency data. Success sets CANCELLED, increments revision once and timestamps cancelled_at/updated_at. Replays are read-only typed rejections.",
      "reasons": [
        "travel_not_found",
        "wrong_owner",
        "already_terminal",
        "already_due",
        "stale_revision"
      ]
    },
    "COMPLETE_LOCATION_MUTATION_ATOMICITY": {
      "decision": "Complete claims one due ACTIVE travel in one Unit of Work. It verifies the user's current location still equals from_node. Source drift sets FAILED and increments revision. Successful completion compare-and-sets current_location to to_node and sets ARRIVED with one revision increment in the same commit. Any persistence exception rolls back both changes."
    },
    "RESTART_RECOVERY_AND_WORKER_POLICY": {
      "decision": "Recovery queries persisted due ACTIVE rows ordered by arrival_at then id, bounded to 100 per batch, and invokes the same completion service. Scheduler ownership is application/infrastructure, not entity logic. Multi-process correctness relies on transactional terminal claim. Notification occurs after commit and failure never rolls back travel; durable outbox is deferred because V1 has none."
    },
    "FAILURE_REASONS_AND_IDEMPOTENCY": {
      "decision": "Queries are side-effect free. Start retry after a successful commit returns already_travelling. Cancel and complete terminal replays never mutate or increment revision. Completion races return terminal_claim_lost or the persisted terminal snapshot. All validation failures occur before aggregate mutation; persistence failures raise after rollback.",
      "canonical_reasons": [
        "already_terminal",
        "already_travelling",
        "invalid_current_node",
        "location_locked",
        "not_adjacent",
        "not_cancellable",
        "not_due",
