  "contract_matrix": [
    {
      "contract": "OVERLEVEL_TRIGGER_AND_THRESHOLD",
      "status": "REFINED",
      "rule": "A location is exceeded only when current_level is strictly greater than its configured maximum; equality does not trigger reconciliation.",
      "owners": [
        "systems/story_quest_system.py",
        "tools/check_story_quest_overlevel_skip_hook.py"
      ]
    },
    {
      "contract": "AFFECTED_QUEST_RANGE_AND_SECTION_BOUNDARY",
      "status": "REFINED",
      "rule": "Reconciliation is location-wide: every canonical quest of each exceeded story location is materialized; section boundaries do not limit the mutation.",
      "owners": [
        "systems/story_quest_system.py",
        "db_modules/story_quests.py",
        "tools/verify_stage_19_34_2_atomic_location_story_skip.py"
      ]
    },
    {
      "contract": "ACTIVE_QUEST_AND_CURRENT_PROGRESS_HANDLING",
      "status": "REFINED",
      "rule": "An unfinished ACTIVE row in an exceeded location becomes SKIPPED with no completion conversion; its location quest-item rows are removed. Already finalized rows remain authoritative.",
      "owners": [
        "db_modules/story_quests.py",
        "tools/verify_stage_19_34_2_atomic_location_story_skip.py"
      ]
    },
    {
      "contract": "SKIPPED_STATE_PERSISTENCE_AND_IDEMPOTENCY",
      "status": "REFINED",
      "rule": "SKIPPED is persistent and finalized. Re-running reconciliation after the same state produces changed=0 and must not rewrite COMPLETED or already SKIPPED rows.",
      "owners": [
        "db_modules/story_quests.py",
        "tools/verify_stage_19_34_2_atomic_location_story_skip.py"
      ]
    },
    {
      "contract": "NEXT_QUEST_AVAILABILITY_AND_CHAIN_CONTINUITY",
      "status": "REFINED",
      "rule": "A predecessor in COMPLETED or SKIPPED satisfies the sequential chain predicate; overlevel reconciliation may finalize a location without leaving a false locked chain.",
      "owners": [
        "systems/story_quest_system.py",
        "handlers/story_quest_hierarchy_ui.py"
      ]
    },
    {
      "contract": "NO_REWARD_AND_NO_QUEST_ITEM_CONSUMPTION",
      "status": "REFINED",
      "rule": "Newly skipped quests retain reward_claimed=0, grant no EXP/gold/items, and delete story quest-item rows for the exceeded location rather than consuming them as a turn-in.",
      "owners": [
        "db_modules/story_quests.py",
        "systems/story_quest_overlevel_system.py",
        "tools/verify_stage_19_34_2_atomic_location_story_skip.py"
      ]
    },
    {
      "contract": "EXPLICIT_SKIP_VS_AUTOMATIC_RECONCILIATION",
      "status": "REFINED",
      "rule": "The canonical Stage 19.18 path is automatic location reconciliation after a qualifying level result. The narrower active-quest skip primitive is not a substitute for location-wide reconciliation.",
      "owners": [
        "systems/story_quest_overlevel_system.py",
        "systems/story_quest_system.py",
        "db_modules/story_quests.py"
      ]
    },
    {
      "contract": "RESTART_RECOVERY_AND_TRANSACTION_BOUNDARY",
      "status": "REFINED",
      "rule": "The database reconciliation owner performs the location-wide write atomically on the supplied connection. Persisted SKIPPED rows and removal of location quest items survive restart; orchestration must not add a hidden commit.",
      "owners": [
        "db_modules/story_quests.py",
        "systems/story_quest_system.py"
      ]
    },
    {
      "contract": "PRESENTATION_HISTORY_AND_NAVIGATION_VISIBILITY",
      "status": "REFINED",
      "rule": "SKIPPED remains visible as a finalized journal/navigation state. User messaging reports the location and the newly skipped count explicitly as skipped without rewards.",
      "owners": [
        "handlers/story_quest_hierarchy_ui.py",
        "systems/story_quest_overlevel_system.py"
      ]
    },
    {
      "contract": "STAGE_19_18_POLICY_AUTHORITY_AND_SUPERSESSION",
      "status": "REFINED",
      "rule": "The current production runtime chain and its later atomic-location verification are authoritative. Historical candidates, broad token hits and shadow helpers cannot supersede this policy without a separate explicit decision.",
      "owners": [
        "handlers/combat.py",
        "systems/story_quest_overlevel_system.py",
        "systems/story_quest_system.py",
        "db_modules/story_quests.py",
        "tools/verify_stage_19_34_2_atomic_location_story_skip.py"
      ]
    }
  ],
