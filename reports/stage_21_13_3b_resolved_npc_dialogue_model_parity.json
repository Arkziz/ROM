      "contract": "DIALOGUE_NODE_AND_ACTION_SCHEMA",
      "classification": "V2_RESOLVED",
      "decision": "V2 parity is a bounded immutable NPC presentation/action model, not a generic branching dialogue graph. The canonical identity is npc_id. An NPC view may expose only V1-confirmed story-quest actions with stable action keys derived from action kind plus referenced quest identity. No persistent dialogue_node_id, arbitrary graph edges or invented universal action kinds are introduced.",
      "typed_reasons": [
        "unknown_npc",
        "action_not_available",
        "malformed_action"
      ]
    },
    {
      "contract": "NPC_AVAILABILITY_AND_CONDITION_POLICY",
      "classification": "V2_RESOLVED",
      "decision": "Availability is evaluated fail-closed in this order: resolve npc_id, verify the NPC canonical location/route, verify the player is in that location, query Quest Engine for the referenced quest state and prerequisites, then materialize visible actions. Unknown NPC, wrong location, unavailable quest and stale action remain distinct typed results. No additional level or condition rules are duplicated outside Quest Engine.",
      "typed_reasons": [
        "unknown_npc",
        "wrong_location",
        "npc_unavailable",
        "stale_action"
      ]
    },
    {
      "contract": "QUEST_AND_NPC_INTERACTION_BOUNDARY",
      "classification": "V2_RESOLVED",
      "decision": "The immutable NPC registry owns NPC identity, localized metadata and location assignment. NPC application query maps registry plus Quest Engine results into a view. Quest Engine exclusively owns quest availability, acceptance, progress, turn-in and rewards. An accept command carries npc_id, quest_id and expected quest revision; NPC service validates the NPC-to-quest reference then delegates the mutation exactly once.",
      "typed_reasons": [
        "quest_not_linked",
        "quest_unavailable",
        "stale_revision",
        "already_active"
      ]
    },
    {
      "contract": "SHOP_SERVICE_AND_OTHER_ACTION_BOUNDARIES",
      "classification": "V2_RESOLVED",
      "decision": "Stage 21.13.3 authorizes only story-quest NPC presentation and quest-linked actions proven by V1. Shop, guild, crafting, auction, daily and rune behavior remain external application services and are not added to the NPC domain. Future NPC links may reference a typed external action only after a separate V1 audit and parity authorization; the NPC model never owns those business mutations.",
      "typed_reasons": [
        "unsupported_action",
        "external_service_not_authorized"
      ]
    },
    {
      "contract": "LOCALIZATION_AND_TECHNICAL_ID_NON_DISCLOSURE",
      "classification": "V2_RESOLVED",
      "decision": "User-visible NPC names and labels come only from canonical registry metadata and localized presentation. Technical npc_id, quest_id and location_id are allowed in DTO identity, callback payloads, logs and tests but never rendered as fallback text. Unknown IDs fail closed; underscore replacement, title-casing and raw-ID display are prohibited.",
      "typed_reasons": [
        "unknown_npc",
        "missing_localized_name",
        "presentation_unavailable"
      ]
    },
    {
      "contract": "PERSISTENCE_RESTART_AND_CONTENT_INDEPENDENCE",
      "classification": "V2_RESOLVED",
      "decision": "NPC definitions are immutable content registry data and require no independent runtime persistence. Restart stability is validated by deterministic registry load plus duplicate-ID, location-route and quest-reference validation. Reusable domain/application modules cannot branch on concrete NPC IDs, quest IDs, NPC names or localized dialogue strings; an executable content-independence gate is mandatory for implementation.",
      "typed_reasons": [
        "duplicate_npc_id",
        "invalid_location_reference",
        "invalid_quest_reference",
        "content_dependency_violation"
      ]
    }
