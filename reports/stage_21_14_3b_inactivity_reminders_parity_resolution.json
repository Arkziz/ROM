{
  "audit_status": "PASS",
  "contracts": [
    {
      "area": "threshold",
      "contract": "A reminder becomes eligible only after seven full 24-hour periods have elapsed since canonical last_activity_at; equality at the threshold is eligible, earlier instants are not.",
      "status": "RESOLVED"
    },
    {
      "area": "clock",
      "contract": "All comparisons use timezone-aware UTC instants and an injected evaluation instant. Unit tests must not depend on wall-clock time.",
      "status": "RESOLVED"
    },
    {
      "area": "cycle_identity",
      "contract": "The inactivity cycle is anchored to the observed last_activity_at value. A changed last_activity_at starts a new cycle; an unchanged value keeps the same cycle.",
      "status": "RESOLVED"
    },
    {
      "area": "exact_once",
      "contract": "At most one successful reminder is recorded for one user and one inactivity-cycle anchor. Repeated evaluation of the same cycle must not send again.",
      "status": "RESOLVED"
    },
    {
      "area": "persistent_audit",
      "contract": "Successful delivery is persisted in inactivity_reminders with the user, cycle anchor and delivery timestamp sufficient to enforce exact-once behavior across restarts.",
      "status": "RESOLVED"
    },
    {
      "area": "delivery_failure",
      "contract": "A failed delivery must not be promoted to a successful exact-once receipt. Retry behavior remains eligible until a successful receipt exists; no retry cadence is invented.",
      "status": "RESOLVED"
    },
    {
      "area": "scheduler_boundary",
      "contract": "This contract defines deterministic eligibility and receipt semantics only. It does not authorize a scheduler cadence, background worker, Telegram runtime wiring, or startup catch-up policy.",
      "status": "RESOLVED"
    },
    {
      "area": "content_boundary",
      "contract": "No new reminder text, reward, penalty, eligibility gate, channel, or user preference is invented. Presentation content remains owned by confirmed V1 evidence or a later runtime-integration stage.",
      "status": "RESOLVED"
    }
  ],
