#!/usr/bin/env python3
# -*- coding: utf-8 -*-
from __future__ import annotations
import ast, inspect, sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path: sys.path.insert(0,str(ROOT))
REPORT=ROOT/"DB_CLEANUP_9_0_12I5A_CHARACTER_DUPLICATES_AUDIT.md"
APIS=(
"normalize_character_name","validate_character_name","get_character_name","set_character_name",
"get_character_class","set_character_class","get_character_class_display","get_character_resource_type",
"get_max_mp","get_user_mp","set_user_mp","refresh_user_mp","grant_class_change_available",
"consume_class_change_available","has_class_change_available")
REVIEW=("get_class_change_available",)
UNIQUE=("is_character_name_taken","needs_character_name","needs_character_class","get_class_reset_sphere_item_id")

def fail(x): print("[FAIL] "+x); raise SystemExit(1)
def parse(path):
 text=path.read_text(encoding="utf-8-sig"); tree=ast.parse(text,filename=str(path)); d={}
 for n in tree.body:
  if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)): d.setdefault(n.name,[]).append(n)
 return text,d
def sig(fn):
 try:return str(inspect.signature(fn))
 except Exception as e:return f"<{e}>"
def safe(fn,*a):
 try:return True,fn(*a)
 except Exception as e:return False,f"{type(e).__name__}: {e}"
def main():
 dbtext,dbdefs=parse(ROOT/"db.py"); systext,sysdefs=parse(ROOT/"systems"/"character_system.py")
 import db
 from systems import character_system as cs
 rows=[]
 for name in APIS:
  dc=len(dbdefs.get(name,[])); sc=len(sysdefs.get(name,[]))
  if dc<2: fail(f"db.py {name}: expected duplicate, got {dc}")
  if sc<1: fail(f"character_system.py missing {name}")
  final=ast.get_source_segment(dbtext,dbdefs[name][-1]) or ""
  system=ast.get_source_segment(systext,sysdefs[name][-1]) or ""
  if "character_system" not in final: fail(f"final db.{name} is not a character_system wrapper")
  if "_legacy_" in system: fail(f"character_system.{name} contains legacy dependency")
  rows.append((name,dc,sc,[n.lineno for n in dbdefs[name]],sig(getattr(db,name)),sig(getattr(cs,name))))
 for name in REVIEW:
  if len(dbdefs.get(name,[]))!=1: fail(f"review API {name} has unexpected db definitions")
  if len(sysdefs.get(name,[]))<1: fail(f"character_system missing review API {name}")
 for name in UNIQUE:
  if len(sysdefs.get(name,[]))<1: fail(f"character_system missing helper {name}")
 # Read-only equivalence for getters on all users.
 getters=("get_character_name","get_character_class","get_character_class_display","get_character_resource_type","get_max_mp","get_user_mp","has_class_change_available","get_class_change_available")
 users=[int(r[0]) for r in db.cursor.execute("SELECT user_id FROM users ORDER BY user_id").fetchall()]
 comparisons=0
 for uid in users:
  for name in getters:
   if safe(getattr(db,name),uid)!=safe(getattr(cs,name),uid): fail(f"getter mismatch {name}, user={uid}")
   comparisons+=1
 # Pure function equivalence.
 samples=("", "  Test  ", "A", "Abc", "Name_1")
 pure=0
 for value in samples:
  for name in ("normalize_character_name","validate_character_name"):
   if safe(getattr(db,name),value)!=safe(getattr(cs,name),value): fail(f"pure mismatch {name}, value={value!r}")
   pure+=1
 report=["# ROM 9.0.12i5a - Character Duplicates Audit","","## Scope","","Read-only audit. No gameplay code or database rows were changed.","","## Cleanup candidates",""]
 for name,dc,sc,lines,ds,ss in rows:
  report.append(f"- `{name}`: db definitions={dc}, db lines={lines}, system definitions={sc}, public signature=`{ds}`, system signature=`{ss}`")
 report += ["","## Manual review / not part of automatic cleanup","",f"- `{REVIEW[0]}`: only one db wrapper; do not delete.","- Unique helpers are not duplicate db cleanup candidates: "+", ".join(f"`{x}`" for x in UNIQUE)+".","","## Runtime","",f"- Getter comparisons: {comparisons}",f"- Pure-function comparisons: {pure}","- Mismatches: 0","- Database mutations: 0","","## Recommendation","","Proceed to 9.0.12i5b with isolated mutation tests for name/class/MP/class-change writes. After equivalence succeeds, i5c may remove only the confirmed earlier db.py definitions while preserving final wrappers and unique helpers.",""]
 REPORT.write_text("\n".join(report),encoding="utf-8")
 print("[OK] character duplicates audit")
 print(f"- duplicate cleanup candidates: {len(APIS)}")
 print(f"- getter comparisons: {comparisons}")
 print(f"- pure-function comparisons: {pure}")
 print("- mismatches: 0")
 print("- legacy dependencies in character_system: 0")
 print("- database mutations: 0")
 print(f"- report: {REPORT}")
if __name__=="__main__": main()
