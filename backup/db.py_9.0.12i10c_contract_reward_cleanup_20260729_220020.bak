def get_item_required_level_by_inventory_id(inventory_id):
    try:
        init_dynamic_equipment_system()
    except Exception:
        pass

    try:
        cursor.execute("""
        SELECT items.item_level
        FROM inventory
        JOIN items ON inventory.item_id = items.id
        WHERE inventory.id=?
        """, (inventory_id,))

        row = cursor.fetchone()

        if not row:
            return 1

        return row[0] or 1

    except Exception:
        return 1


