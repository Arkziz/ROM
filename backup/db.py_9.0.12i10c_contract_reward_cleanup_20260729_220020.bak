# ✅ INVENTORY READ
# ==============================

def get_inventory(user_id):
    cursor.execute("""
    SELECT item_id
    FROM inventory
    WHERE user_id=?
    """, (user_id,))

    return cursor.fetchall()










def consume_inventory_item(user_id, inventory_id, quantity=1):
    entry = get_inventory_entry(user_id, inventory_id)

    if not entry:
        return False

    inv_id, item_id, name, type_, category, current_quantity = entry

    if current_quantity is None:
        current_quantity = 1

    if current_quantity < quantity:
        return False

    new_quantity = current_quantity - quantity

    if new_quantity <= 0:
        cursor.execute("""
        DELETE FROM inventory
        WHERE id=? AND user_id=?
        """, (inventory_id, user_id))
    else:
        cursor.execute("""
        UPDATE inventory
        SET quantity=?
        WHERE id=? AND user_id=?
        """, (new_quantity, inventory_id, user_id))

    conn.commit()
    return True


def find_first_item_stack_by_type(user_id, item_type):
    cursor.execute("""
    SELECT inventory.id
    FROM inventory
    JOIN items ON inventory.item_id = items.id
    WHERE inventory.user_id=?
      AND items.type=?
      AND inventory.quantity > 0
    ORDER BY inventory.id ASC
    LIMIT 1
    """, (user_id, item_type))

    row = cursor.fetchone()

    if not row:
        return None

    return row[0]


