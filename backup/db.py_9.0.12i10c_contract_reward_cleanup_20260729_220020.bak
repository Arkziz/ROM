ARMOR_SLOTS = [
    "helmet",
    "shoulders",
    "chest",
    "gloves",
    "legs",
    "boots"
]


ARMOR_ALLOWED_BY_CLASS = {
    "mage": "cloth",
    "priest": "cloth",

    "scout": "leather",
    "rogue": "leather",

    "warrior": "chain",
    "knight": "plate"
}


MAIN_HAND_ALLOWED_BY_CLASS = {
    "mage": ["wand_1h", "staff_2h"],
    "priest": ["wand_1h", "staff_2h"],

    "scout": ["bow_2h", "crossbow_2h"],
    "rogue": ["dagger_1h"],

    "warrior": ["sword_1h", "sword_2h"],
    "knight": ["sword_1h"]
}


OFF_HAND_ALLOWED_BY_CLASS = {
    "mage": ["talisman"],
    "priest": ["talisman"],

    "scout": [],
    "rogue": ["dagger"],

    "warrior": [],
    "knight": ["shield"]
}


ARMOR_TYPE_LABELS = {
    "cloth": "Тканина",
    "leather": "Шкіра",
    "chain": "Кольчуга",
    "plate": "Лати",
    "": "Універсальний"
}


ITEM_SUBTYPE_LABELS = {
    "sword_1h": "Одноручний меч",
    "sword_2h": "Дворучний меч",
    "dagger_1h": "Кинджал",
    "wand_1h": "Жезл",
    "staff_2h": "Дворучний посох",
    "bow_2h": "Лук",
