# ==============================
# ✅ DEV EQUIPMENT GENERATION HELPERS
# ==============================

def normalize_dev_rarity(rarity):
    rarity = (rarity or "common").strip().lower()

    aliases = {
        "white": "common",
        "білий": "common",
        "bilyi": "common",

        "green": "uncommon",
        "зелений": "uncommon",
        "zelenyi": "uncommon",

        "blue": "rare",
        "синій": "rare",
        "synii": "rare",

        "purple": "epic",
        "фіолетовий": "epic",
        "fioletovyi": "epic",
    }

    rarity = aliases.get(rarity, rarity)

    if rarity not in ["common", "uncommon", "rare", "epic"]:
        rarity = "common"

    return rarity


def create_dev_armor_item_for_test(user_id, armor_type, slot_key="chest", item_level=None, rarity="common"):
    """
    DEV-функція.
    Створює броню конкретного armor_type незалежно від класу.

    Приклад:
    create_dev_armor_item_for_test(user_id, "plate", "chest", 5, "rare")
    """

    init_dynamic_equipment_system()
    init_weapon_damage_system()
    init_class_equipment_restrictions_system()

    armor_type = normalize_equipment_restriction_value(armor_type)
    rarity = normalize_dev_rarity(rarity)

    if armor_type not in ["cloth", "leather", "chain", "plate"]:
        return {
            "success": False,
            "message": (
                "❌ Невідомий тип броні.\n\n"
                "Доступно:\n"
                "cloth, leather, chain, plate"
            )
        }

    if slot_key not in ARMOR_SLOTS:
        return {
            "success": False,
            "message": (
                "❌ Невідомий слот броні.\n\n"
                "Доступно:\n"
                "helmet, shoulders, chest, gloves, legs, boots"
            )
        }

    if item_level is None:
        item_level = get_player_level(user_id)

    try:
        item_level = int(item_level)
    except Exception:
        item_level = get_player_level(user_id)

    item_level = max(1, item_level)

    capacity = get_bag_capacity(user_id)
    used_slots = get_inventory_used_slots(user_id)

    if used_slots >= capacity:
        return {
            "success": False,
            "message": "🎒 Сумка переповнена. Предмет не створено."
        }

    item_profile = ""
    weapon_hands = 1
    weapon_attack_type = ""

    base_name = get_dynamic_armor_name(slot_key, rarity)
    armor_label = get_armor_type_label(armor_type)
    name = f"{base_name} [{armor_label}] {item_level} рівня"

    stats = generate_dynamic_equipment_stats(
        slot_key=slot_key,
        item_level=item_level,
        rarity=rarity,
        weapon_hands=weapon_hands,
        item_profile=item_profile
    )

    stats = apply_armor_type_defense_profile_to_stats(
        stats=stats,
        armor_type=armor_type
    )

    sell_price = get_dynamic_sell_price(item_level, rarity)

    cursor.execute("""
    INSERT INTO items (
        name,
        type,
        rarity,
        category,
        slot_key,
        weapon_hands,
        max_stack,
        sell_price,
        bonus_str,
        bonus_dex,
        bonus_int,
        bonus_wis,
        bonus_sta,
        pdef,
        mdef,
        item_level,
        is_generated,
        item_subtype,
        weapon_min_damage,
        weapon_max_damage,
        weapon_min_magic_damage,
        weapon_max_magic_damage,
        weapon_attack_type,
        armor_type
    )
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        name,
        slot_key,
        rarity,
        "equipment",
        slot_key,
        weapon_hands,
        1,
        sell_price,
        stats["bonus_str"],
        stats["bonus_dex"],
        stats["bonus_int"],
        stats["bonus_wis"],
        stats["bonus_sta"],
        stats["pdef"],
        stats["mdef"],
        item_level,
        1,
        item_profile,
        0,
        0,
        0,
        0,
        weapon_attack_type,
        armor_type
    ))

    item_id = cursor.lastrowid

    cursor.execute("""
    INSERT INTO inventory (
        user_id,
        item_id,
        quantity,
        durability
    )
    VALUES (?, ?, ?, ?)
    """, (
        user_id,
        item_id,
        1,
        100
    ))

    inventory_id = cursor.lastrowid

    conn.commit()

    return {
        "success": True,
        "message": (
            f"✅ DEV: броню створено.\n\n"
            f"📦 {name}\n"
            f"🎯 Слот: {EQUIPMENT_SLOTS.get(slot_key, slot_key)}\n"
            f"🧵 Тип броні: {get_armor_type_label(armor_type)}\n"
            f"🏷 Рівень: {item_level}\n"
            f"⭐ Рідкість: {rarity}\n"
            f"🆔 inventory_id: {inventory_id}"
        ),
        "item_id": item_id,
        "inventory_id": inventory_id,
        "armor_type": armor_type,
        "slot_key": slot_key
    }


def create_dev_weapon_item_for_test(user_id, item_profile, item_level=None, rarity="common"):
    """
    DEV-функція.
    Створює зброю або off-hand конкретного item_subtype незалежно від класу.

    Приклади:
    create_dev_weapon_item_for_test(user_id, "dagger_1h", 5, "rare")
    create_dev_weapon_item_for_test(user_id, "shield", 5, "common")
    """

    init_dynamic_equipment_system()
    init_weapon_damage_system()
    init_class_equipment_restrictions_system()

    item_profile = normalize_equipment_restriction_value(item_profile)
    rarity = normalize_dev_rarity(rarity)

    if item_profile in MAIN_HAND_PROFILES:
        slot_key = "main_hand"
        profile = MAIN_HAND_PROFILES[item_profile]
        weapon_hands = profile["hands"]
        weapon_attack_type = profile["attack_type"]
        type_ = "weapon"

    elif item_profile in OFF_HAND_PROFILES:
        slot_key = "off_hand"
        profile = OFF_HAND_PROFILES[item_profile]
        weapon_hands = 1
        weapon_attack_type = profile["attack_type"]
        type_ = "offhand"

    else:
        return {
            "success": False,
            "message": (
                "❌ Невідомий тип зброї / off-hand.\n\n"
                "Main hand:\n"
                "sword_1h, dagger_1h, wand_1h, sword_2h, staff_2h, bow_2h, crossbow_2h\n\n"
                "Off hand:\n"
                "shield, talisman, dagger"
            )
        }

    if item_level is None:
        item_level = get_player_level(user_id)

    try:
        item_level = int(item_level)
    except Exception:
        item_level = get_player_level(user_id)

    item_level = max(1, item_level)

    capacity = get_bag_capacity(user_id)
    used_slots = get_inventory_used_slots(user_id)

    if used_slots >= capacity:
        return {
            "success": False,
            "message": "🎒 Сумка переповнена. Предмет не створено."
        }

    name = get_dynamic_weapon_name(
        slot_key=slot_key,
        rarity=rarity,
        weapon_hands=weapon_hands,
        item_profile=item_profile
    )

    name = f"{name} {item_level} рівня"

    stats = generate_dynamic_equipment_stats(
        slot_key=slot_key,
        item_level=item_level,
        rarity=rarity,
        weapon_hands=weapon_hands,
        item_profile=item_profile
    )

    sell_price = get_dynamic_sell_price(item_level, rarity)

    weapon_min_damage = 0
    weapon_max_damage = 0
    weapon_min_magic_damage = 0
    weapon_max_magic_damage = 0

    if slot_key == "main_hand":
        min_dmg, max_dmg = calculate_weapon_damage_by_values(
            item_level=item_level,
            rarity=rarity,
            weapon_hands=weapon_hands
        )

        if weapon_attack_type == "magical":
            weapon_min_magic_damage = min_dmg
            weapon_max_magic_damage = max_dmg
        else:
            weapon_min_damage = min_dmg
            weapon_max_damage = max_dmg

    cursor.execute("""
    INSERT INTO items (
        name,
        type,
        rarity,
        category,
        slot_key,
        weapon_hands,
        max_stack,
        sell_price,
        bonus_str,
        bonus_dex,
        bonus_int,
        bonus_wis,
        bonus_sta,
        pdef,
        mdef,
        item_level,
        is_generated,
        item_subtype,
        weapon_min_damage,
        weapon_max_damage,
        weapon_min_magic_damage,
        weapon_max_magic_damage,
        weapon_attack_type,
        armor_type
    )
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        name,
        type_,
        rarity,
        "equipment",
        slot_key,
        weapon_hands,
        1,
        sell_price,
        stats["bonus_str"],
        stats["bonus_dex"],
        stats["bonus_int"],
        stats["bonus_wis"],
        stats["bonus_sta"],
        stats["pdef"],
        stats["mdef"],
        item_level,
        1,
        item_profile,
        weapon_min_damage,
        weapon_max_damage,
        weapon_min_magic_damage,
        weapon_max_magic_damage,
        weapon_attack_type,
        ""
    ))

    item_id = cursor.lastrowid

    cursor.execute("""
    INSERT INTO inventory (
        user_id,
        item_id,
        quantity,
        durability
    )
    VALUES (?, ?, ?, ?)
    """, (
        user_id,
        item_id,
        1,
        100
    ))

    inventory_id = cursor.lastrowid

    conn.commit()

    return {
        "success": True,
        "message": (
            f"✅ DEV: зброю / off-hand створено.\n\n"
            f"📦 {name}\n"
            f"🎯 Слот: {EQUIPMENT_SLOTS.get(slot_key, slot_key)}\n"
            f"⚔️ Тип предмета: {get_item_subtype_label(item_profile)}\n"
            f"🏷 Рівень: {item_level}\n"
            f"⭐ Рідкість: {rarity}\n"
            f"🆔 inventory_id: {inventory_id}"
        ),
        "item_id": item_id,
        "inventory_id": inventory_id,
        "item_subtype": item_profile,
        "slot_key": slot_key
    }

# ==============================
# ✅ OVERRIDE: CLASS-AWARE DYNAMIC LOOT
# ==============================

def get_random_loot_armor_type():
    """
    Випадковий armor_type для повністю випадкового дропу.
    """

    return random.choice([
        "cloth",
        "leather",
        "chain",
        "plate"
    ])


def get_random_class_aware_equipment_choice(user_id):
    """
    Повертає slot_key, item_profile, armor_type для предмета під клас.

    Логіка:
    - броня під клас;
    - main_hand під клас;
    - off_hand під клас, якщо клас має дозволений off_hand.
    """

    class_key = get_character_class(user_id)

    allowed_armor_type = get_allowed_armor_type_for_class(class_key)
    allowed_main_hand = get_allowed_main_hand_subtypes_for_class(class_key)
    allowed_off_hand = get_allowed_off_hand_subtypes_for_class(class_key)

    has_off_hand = len(allowed_off_hand) > 0

    roll = random.random()

    # Якщо клас має off-hand:
    # 60% броня, 25% main hand, 15% off hand.
    if has_off_hand:
        if roll < 0.60:
            return {
                "slot_key": random.choice(ARMOR_SLOTS),
                "item_profile": "",
                "armor_type": allowed_armor_type
            }

        if roll < 0.85:
            return {
                "slot_key": "main_hand",
                "item_profile": random.choice(allowed_main_hand),
                "armor_type": ""
            }

        return {
            "slot_key": "off_hand",
            "item_profile": random.choice(allowed_off_hand),
            "armor_type": ""
        }

    # Якщо клас НЕ має off-hand:
    # 65% броня, 35% main hand.
    if roll < 0.65:
        return {
            "slot_key": random.choice(ARMOR_SLOTS),
            "item_profile": "",
            "armor_type": allowed_armor_type
        }

    return {
        "slot_key": "main_hand",
        "item_profile": random.choice(allowed_main_hand),
        "armor_type": ""
    }


def get_random_unrestricted_equipment_choice():
    """
    Повертає slot_key, item_profile, armor_type для повністю випадкового предмета.
    """

    slot_key = get_dynamic_slot_key()
    item_profile = get_profile_for_generated_item(slot_key)
    armor_type = ""

    if is_armor_slot(slot_key):
        armor_type = get_random_loot_armor_type()
        item_profile = ""

    return {
        "slot_key": slot_key,
        "item_profile": item_profile,
        "armor_type": armor_type
    }


def create_generated_equipment_item(
    user_id,
    item_level,
    rarity,
    class_aware_chance=0.0
):
    """
    Динамічний дроп екіпірування з мобів.

    class_aware_chance:
    - 0.0 = повністю випадковий предмет;
    - 0.5 = 50% шанс предмета під клас;
    - 0.7 = 70% шанс предмета під клас.

    Для class-aware предмета:
    - броня отримує armor_type класу;
    - зброя отримує item_subtype, дозволений класу;
    - off-hand отримує item_subtype, дозволений класу.

    Для random предмета:
    - броня отримує випадковий armor_type;
    - зброя/off-hand отримує випадковий item_subtype.
    """

    init_dynamic_equipment_system()
    init_weapon_damage_system()
    init_class_equipment_restrictions_system()

    item_level = int(item_level)
    item_level = max(1, item_level)

    if rarity not in ["common", "uncommon", "rare", "epic"]:
        rarity = "common"

    capacity = get_bag_capacity(user_id)
    used_slots = get_inventory_used_slots(user_id)

    if used_slots >= capacity:
        return {
            "success": False,
            "lost": 1,
            "message": "🎒 Сумка переповнена. Екіпірування не влізло."
        }

    try:
        class_aware_chance = float(class_aware_chance or 0.0)
    except Exception:
        class_aware_chance = 0.0

    class_aware_chance = max(0.0, min(1.0, class_aware_chance))

    is_class_aware = random.random() <= class_aware_chance

    if is_class_aware:
        choice = get_random_class_aware_equipment_choice(user_id)
    else:
        choice = get_random_unrestricted_equipment_choice()

    slot_key = choice["slot_key"]
    item_profile = choice.get("item_profile", "")
    armor_type = choice.get("armor_type", "")

    weapon_hands = 1
    weapon_attack_type = ""

    # ==============================
    # MAIN HAND
    # ==============================

    if slot_key == "main_hand":
        if item_profile not in MAIN_HAND_PROFILES:
            item_profile = get_random_main_hand_profile()

        profile = MAIN_HAND_PROFILES[item_profile]

        weapon_hands = profile["hands"]
        weapon_attack_type = profile["attack_type"]

        name = get_dynamic_weapon_name(
            slot_key=slot_key,
            rarity=rarity,
            weapon_hands=weapon_hands,
            item_profile=item_profile
        )

        type_ = "weapon"

    # ==============================
    # OFF HAND
    # ==============================

    elif slot_key == "off_hand":
        if item_profile not in OFF_HAND_PROFILES:
            item_profile = get_random_off_hand_profile()

        profile = OFF_HAND_PROFILES[item_profile]

        weapon_hands = 1
        weapon_attack_type = profile["attack_type"]

        name = get_dynamic_weapon_name(
            slot_key=slot_key,
            rarity=rarity,
            weapon_hands=weapon_hands,
            item_profile=item_profile
        )

        type_ = "offhand"

    # ==============================
    # ARMOR / ACCESSORIES
    # ==============================

    else:
        item_profile = ""
        weapon_hands = 1

        if is_armor_slot(slot_key):
            if not armor_type:
                armor_type = get_random_loot_armor_type()
        else:
            armor_type = ""

        name = get_dynamic_armor_name(slot_key, rarity)
        type_ = slot_key

    rarity_name = DYNAMIC_RARITY_NAMES.get(rarity, "Звичайний")
    name = f"{name} {item_level} рівня"

    stats = generate_dynamic_equipment_stats(
        slot_key=slot_key,
        item_level=item_level,
        rarity=rarity,
        weapon_hands=weapon_hands,
        item_profile=item_profile
    )

    if is_armor_slot(slot_key):
        stats = apply_armor_type_defense_profile_to_stats(
            stats=stats,
            armor_type=armor_type
        )

    sell_price = get_dynamic_sell_price(item_level, rarity)

    weapon_min_damage = 0
    weapon_max_damage = 0
    weapon_min_magic_damage = 0
    weapon_max_magic_damage = 0

    if slot_key == "main_hand":
        min_dmg, max_dmg = calculate_weapon_damage_by_values(
            item_level=item_level,
            rarity=rarity,
            weapon_hands=weapon_hands
        )

        if weapon_attack_type == "magical":
            weapon_min_magic_damage = min_dmg
            weapon_max_magic_damage = max_dmg
        else:
            weapon_min_damage = min_dmg
            weapon_max_damage = max_dmg

    cursor.execute("""
    INSERT INTO items (
        name,
        type,
        rarity,
        category,
        slot_key,
        weapon_hands,
        max_stack,
        sell_price,
        bonus_str,
        bonus_dex,
        bonus_int,
        bonus_wis,
        bonus_sta,
        pdef,
        mdef,
        item_level,
        is_generated,
        item_subtype,
        weapon_min_damage,
        weapon_max_damage,
        weapon_min_magic_damage,
        weapon_max_magic_damage,
        weapon_attack_type,
        armor_type
    )
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        name,
        type_,
        rarity,
        "equipment",
        slot_key,
        weapon_hands,
        1,
        sell_price,
        stats["bonus_str"],
        stats["bonus_dex"],
        stats["bonus_int"],
        stats["bonus_wis"],
        stats["bonus_sta"],
        stats["pdef"],
        stats["mdef"],
        item_level,
        1,
        item_profile,
        weapon_min_damage,
        weapon_max_damage,
        weapon_min_magic_damage,
        weapon_max_magic_damage,
        weapon_attack_type,
        armor_type
    ))

    item_id = cursor.lastrowid

    cursor.execute("""
    INSERT INTO inventory (
        user_id,
        item_id,
        quantity,
        durability
    )
    VALUES (?, ?, ?, ?)
    """, (
        user_id,
        item_id,
        1,
        100
    ))

    inventory_id = cursor.lastrowid

    conn.commit()

    return {
        "success": True,
        "lost": 0,
        "name": name,
        "rarity": rarity,
        "rarity_name": rarity_name,
        "slot_key": slot_key,
        "item_id": item_id,
        "inventory_id": inventory_id,
        "armor_type": armor_type,
        "item_subtype": item_profile,
        "class_aware": is_class_aware,
        "message": f"{name}"
    }

