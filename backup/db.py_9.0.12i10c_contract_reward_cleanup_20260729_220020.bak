def detect_weapon_profile_from_name(name):
    if not name:
        return ""

    lowered = name.lower()

    if "дворучний посох" in lowered:
        return "staff_2h"

    if "жезл" in lowered or "одноручний посох" in lowered:
        return "wand_1h"

    if "дворучний меч" in lowered:
        return "sword_2h"

    if "кинджал" in lowered:
        return "dagger_1h"

    if "лук" in lowered:
        return "bow_2h"

    if "арбалет" in lowered:
        return "crossbow_2h"

    if "меч" in lowered:
        return "sword_1h"

    if "щит" in lowered:
        return "shield"

    if "талісман" in lowered:
        return "talisman"

    return ""

