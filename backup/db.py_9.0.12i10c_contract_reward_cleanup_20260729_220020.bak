def get_bag_capacity(user_id):
    cursor.execute("""
    SELECT bag_slots
    FROM users
    WHERE user_id=?
    """, (user_id,))

    row = cursor.fetchone()

    if not row or row[0] is None:
        return 20

    return row[0]


def get_inventory_used_slots(user_id):
    cursor.execute("""
    SELECT COUNT(*)
    FROM inventory
    WHERE user_id=?
    """, (user_id,))

    row = cursor.fetchone()

    if not row:
        return 0

    return row[0]


# ==============================
# ✅ ADD ITEM WITH STACKING
# ==============================

def add_item(user_id, item_id, quantity=1):
    item = get_item_full(item_id)

    if not item:
        return {
            "success": False,
            "added": 0,
            "lost": quantity,
            "message": "❌ Предмет не знайдено"
        }

    (
        _,
        name,
        type_,
        rarity,
        category,
        slot_key,
        weapon_hands,
        max_stack,
        sell_price,
        b_str,
        b_dex,
        b_int,
        b_wis,
        b_sta,
        pdef,
        mdef
    ) = item

    max_stack = max_stack or 1
    capacity = get_bag_capacity(user_id)
    added = 0
    lost = 0

    if max_stack <= 1:
        for _ in range(quantity):
            used = get_inventory_used_slots(user_id)

            if used >= capacity:
                lost += 1
                continue

            durability = 100 if category == "equipment" else None

            cursor.execute("""
            INSERT INTO inventory (user_id, item_id, quantity, durability)
            VALUES (?, ?, ?, ?)
            """, (user_id, item_id, 1, durability))

            added += 1

        conn.commit()

        return {
            "success": added > 0,
            "added": added,
            "lost": lost,
            "name": name,
            "used_slots": get_inventory_used_slots(user_id),
            "capacity": capacity
        }

    remaining = quantity

    cursor.execute("""
    SELECT id, quantity
    FROM inventory
    WHERE user_id=? AND item_id=? AND quantity < ?
    ORDER BY id ASC
    """, (user_id, item_id, max_stack))

    stacks = cursor.fetchall()

    for inv_id, current_qty in stacks:
        if remaining <= 0:
            break

        current_qty = current_qty or 0
        space = max_stack - current_qty
        to_add = min(space, remaining)

        cursor.execute("""
        UPDATE inventory
        SET quantity = quantity + ?
        WHERE id=?
        """, (to_add, inv_id))

        remaining -= to_add
        added += to_add

    while remaining > 0:
        used = get_inventory_used_slots(user_id)

        if used >= capacity:
            lost += remaining
            remaining = 0
            break

        to_add = min(max_stack, remaining)

        cursor.execute("""
        INSERT INTO inventory (user_id, item_id, quantity, durability)
        VALUES (?, ?, ?, ?)
        """, (user_id, item_id, to_add, None))

        remaining -= to_add
        added += to_add

    conn.commit()

    return {
        "success": added > 0,
        "added": added,
        "lost": lost,
        "name": name,
        "used_slots": get_inventory_used_slots(user_id),
        "capacity": capacity
    }


