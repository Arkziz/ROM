GOLD_ICON = "💰"
GOLD_NAME = "золото"


def format_gold(amount):
    try:
        amount = float(amount)
    except Exception:
        amount = 0.0

    return f"{amount:.2f} {GOLD_ICON} {GOLD_NAME}"


