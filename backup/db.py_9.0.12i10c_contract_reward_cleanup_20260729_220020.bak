# ==============================
# ✅ GUILD CONTRACT REWARD CLAIM HOOK V1
# ==============================

# 7.0.9a
# Точний hook для поточної системи контрактів у db.py.
# Контракт здається через claim_contract_reward(user_id), тому Guild EXP/Resource
# треба нараховувати саме після успішної здачі контракту.
#
# Нагорода гільдії:
# - +50 Guild EXP
# - +3 Guild Resource
# - +1 guild contract

try:
    _base_claim_contract_reward_before_guild_reward_v1 = claim_contract_reward
except Exception:
    _base_claim_contract_reward_before_guild_reward_v1 = None


def _guild_contract_reward_result_success_v1(result):
    if not result:
        return False

    if isinstance(result, dict):
        if result.get("success") is False:
            return False

        message = str(result.get("message", ""))

        if "🎁 Контракт здано" in message:
            return True

        if "Контракт здано" in message:
            return True

        return False

    return False


def _guild_contract_reward_append_message_v1(result, guild_result):
    try:
        guild_text = get_guild_activity_reward_text(guild_result)
    except Exception:
        guild_text = None

    if not guild_text:
        return result

    if isinstance(result, dict):
        message = str(result.get("message", ""))
        if guild_text not in message:
            result = dict(result)
            result["message"] = message.rstrip() + "\n" + guild_text
        return result

    return result


def claim_contract_reward(user_id):
    """Public Contract Reward facade backed by systems.contract_system."""
    from systems.contract_system import claim_contract_reward as _func
    return _func(user_id)


# ==============================
# ✅ CONTRACT TARGET KILLS 5 V1
# ==============================

# 7.0.9c
# Баланс контрактів:
# було: 10 вбивств
# стало: 5 вбивств
#
# Важливо:
# - нові контракти створюються з target_kills=5;
# - старі активні контракти з target_kills > 5 автоматично стискаються до 5;
# - якщо у старому активному контракті вже current_kills >= 5, контракт стає completed.

CONTRACT_TARGET_KILLS = 5


def migrate_active_contracts_target_kills_to_5():
    init_contract_system()

    cursor.execute("""
    UPDATE user_active_contracts
    SET target_kills=5
    WHERE target_kills > 5
    """)

    cursor.execute("""
    UPDATE user_active_contracts
    SET completed=1,
        current_kills=5
    WHERE target_kills=5
      AND current_kills >= 5
      AND reward_claimed=0
    """)

    conn.commit()

    return True


try:
    migrate_active_contracts_target_kills_to_5()
except Exception as _contract_target_kills_5_error:
    print(f"⚠️ Contract target kills migration failed: {_contract_target_kills_5_error}")


