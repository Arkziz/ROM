"""
ROM Equipment System — Read-only Facade
=======================================

Refactor 9.0.6 compatibility module.

Scope of this step:
- read-only equipment/inventory/equipped-item helpers;
- weapon damage read-only helpers;
- compatibility read-only helpers, if they exist in db.py.

Not included yet:
- equip/unequip write actions;
- repair write actions;
- durability write actions;
- sell/write economy actions.

This stage is intentionally conservative:
- db.py remains the public compatibility facade for handlers;
- legacy implementations are kept in db.py as _legacy_equipment_ro_v1_* references;
- this module delegates to those legacy implementations.
"""


def _db():
    import db
    return db


def _call_legacy(name, *args, **kwargs):
    db = _db()
    legacy_name = f"_legacy_equipment_ro_v1_{name}"
    legacy = getattr(db, legacy_name, None)

    if legacy is None:
        raise AttributeError(f"Legacy equipment read-only function not found: {legacy_name}")

    return legacy(*args, **kwargs)


# The concrete functions are generated by the patch below.


def ensure_equipment_slots(*args, **kwargs):
    return _call_legacy('ensure_equipment_slots', *args, **kwargs)

def get_all_equipped_items(*args, **kwargs):
    return _call_legacy('get_all_equipped_items', *args, **kwargs)

def get_equipped_items_for_repair(*args, **kwargs):
    return _call_legacy('get_equipped_items_for_repair', *args, **kwargs)

def get_inventory_detailed(*args, **kwargs):
    return _call_legacy('get_inventory_detailed', *args, **kwargs)

def get_inventory_entry(*args, **kwargs):
    return _call_legacy('get_inventory_entry', *args, **kwargs)

def get_item_by_inventory_id(*args, **kwargs):
    return _call_legacy('get_item_by_inventory_id', *args, **kwargs)

def get_item_by_inventory_id_full(*args, **kwargs):
    return _call_legacy('get_item_by_inventory_id_full', *args, **kwargs)

def get_item_bonuses(*args, **kwargs):
    return _call_legacy('get_item_bonuses', *args, **kwargs)

def get_equipped_item_defenses(*args, **kwargs):
    return _call_legacy('get_equipped_item_defenses', *args, **kwargs)

def get_sellable_equipment_items(*args, **kwargs):
    return _call_legacy('get_sellable_equipment_items', *args, **kwargs)

def init_weapon_damage_system(*args, **kwargs):
    return _call_legacy('init_weapon_damage_system', *args, **kwargs)

def calculate_weapon_damage_by_values(*args, **kwargs):
    return _call_legacy('calculate_weapon_damage_by_values', *args, **kwargs)

def get_weapon_damage_by_inventory_id(*args, **kwargs):
    return _call_legacy('get_weapon_damage_by_inventory_id', *args, **kwargs)

def get_inventory_weapon_damage_display(*args, **kwargs):
    return _call_legacy('get_inventory_weapon_damage_display', *args, **kwargs)

