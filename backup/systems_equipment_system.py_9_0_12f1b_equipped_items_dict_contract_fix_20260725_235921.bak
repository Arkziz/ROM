# ✅ REFACTOR 9.0.7: EQUIPMENT WRITE API
# Write-operation wrappers. These delegate to legacy db.py implementations
# and synchronize dynamic max HP after equipment changes.

def _call_legacy_write(name, *args, **kwargs):
    db = _db()
    legacy_name = f'_legacy_equipment_write_v1_{name}'
    legacy = getattr(db, legacy_name, None)
    if legacy is None:
        # Fallback for functions that may already have been captured by read-only facade naming.
        legacy = getattr(db, f'_legacy_equipment_ro_v1_{name}', None)
    if legacy is None:
        raise AttributeError(f'Legacy equipment write function not found: {legacy_name}')
    return legacy(*args, **kwargs)

def _extract_equipment_user_id(args, kwargs):
    if 'user_id' in kwargs:
        return kwargs.get('user_id')
    if args:
        return args[0]
    return None

def _sync_equipment_player_hp(user_id):
    if user_id is None:
        return None
    try:
        db = _db()
        sync = getattr(db, 'sync_user_max_hp', None)
        if sync:
            try:
                return sync(user_id, heal_to_full=False)
            except TypeError:
                return sync(user_id)
    except Exception:
        return None
    return None

def equip_inventory_item(*args, **kwargs):
    user_id = _extract_equipment_user_id(args, kwargs)
    result = _call_legacy_write('equip_inventory_item', *args, **kwargs)
    _sync_equipment_player_hp(user_id)
    return result

def unequip_inventory_item(*args, **kwargs):
    user_id = _extract_equipment_user_id(args, kwargs)
    result = _call_legacy_write('unequip_inventory_item', *args, **kwargs)
    _sync_equipment_player_hp(user_id)
    return result

def unequip_incompatible_items_after_class_change(*args, **kwargs):
    user_id = _extract_equipment_user_id(args, kwargs)
    result = _call_legacy_write('unequip_incompatible_items_after_class_change', *args, **kwargs)
    _sync_equipment_player_hp(user_id)
    return result

# ✅ REFACTOR 9.0.8: EQUIPMENT REPAIR DURABILITY SELL API
# Repair/durability/sell wrappers. These delegate to legacy db.py implementations
# and synchronize dynamic max HP after operations that can affect equipped bonuses.

def _call_legacy_repair_durability_sell(name, *args, **kwargs):
    db = _db()
    legacy_name = f'_legacy_equipment_rds_v1_{name}'
    legacy = getattr(db, legacy_name, None)
    if legacy is None:
        legacy = getattr(db, f'_legacy_equipment_write_v1_{name}', None)
    if legacy is None:
        legacy = getattr(db, f'_legacy_equipment_ro_v1_{name}', None)
    if legacy is None:
        raise AttributeError(f'Legacy equipment repair/durability/sell function not found: {legacy_name}')
    return legacy(*args, **kwargs)

def _extract_user_id_for_rds(args, kwargs):
    if 'user_id' in kwargs:
        return kwargs.get('user_id')
    if args:
        return args[0]
    return None

def _sync_hp_after_rds(user_id):
    if user_id is None:
        return None
    try:
        db = _db()
        sync = getattr(db, 'sync_user_max_hp', None)
        if sync:
            try:
                return sync(user_id, heal_to_full=False)
            except TypeError:
                return sync(user_id)
    except Exception:
        return None
    return None

def repair_equipped_item(*args, **kwargs):
    user_id = _extract_user_id_for_rds(args, kwargs)
    result = _call_legacy_repair_durability_sell('repair_equipped_item', *args, **kwargs)
    _sync_hp_after_rds(user_id)
    return result

def repair_all_equipped(*args, **kwargs):
    user_id = _extract_user_id_for_rds(args, kwargs)
    result = _call_legacy_repair_durability_sell('repair_all_equipped', *args, **kwargs)
    _sync_hp_after_rds(user_id)
    return result

def calculate_repair_cost(*args, **kwargs):
    user_id = _extract_user_id_for_rds(args, kwargs)
    result = _call_legacy_repair_durability_sell('calculate_repair_cost', *args, **kwargs)
    return result

def damage_equipped_items_on_death(*args, **kwargs):
    user_id = _extract_user_id_for_rds(args, kwargs)
    result = _call_legacy_repair_durability_sell('damage_equipped_items_on_death', *args, **kwargs)
    _sync_hp_after_rds(user_id)
    return result

def sell_inventory_item_to_trader(*args, **kwargs):
    user_id = _extract_user_id_for_rds(args, kwargs)
