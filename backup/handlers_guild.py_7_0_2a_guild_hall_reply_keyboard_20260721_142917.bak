from telebot import types

from db import (
    init_guild_system,
    get_user_guild,
    get_user_guild_member,
    get_guild_members,
    get_guild_member_count,
    get_guild_ranking,
    get_guild_display_name,
    get_guild_role_label,
    get_current_guild_season_key,
)

from keyboards import city_kb


GUILD_RANKING_LIMIT = 10


# ==============================
# TEXT BUILDERS
# ==============================

def build_guild_hall_no_guild_text(user_id):
    season_key = get_current_guild_season_key()

    return (
        "🏰 Зала Гільдій\n\n"
        "У просторій залі з кам’яними прапорами герої об’єднуються у гільдії, "
        "подають заявки та змагаються за місце у рейтингу.\n\n"
        "Ти поки не перебуваєш у гільдії.\n\n"
        "Доступні дії:\n"
        "• 🏗️ Створити гільдію\n"
        "• 📜 Переглянути гільдії\n"
        "• 🏆 Рейтинг гільдій\n"
        "• 📨 Мої заявки\n\n"
        f"Поточний рейтинговий сезон: {season_key}"
    )


def build_guild_hall_member_text(user_id):
    guild = get_user_guild(user_id)
    member = get_user_guild_member(user_id)

    if not guild or not member:
        return build_guild_hall_no_guild_text(user_id)

    season_key = get_current_guild_season_key()
    guild_name = get_guild_display_name(guild)
    role_label = get_guild_role_label(member["role"])
    member_count = get_guild_member_count(guild["id"])

    return (
        f"🏰 Гільдія\n\n"
        f"{guild_name}\n"
        f"Твоя роль: {role_label}\n\n"
        f"Рівень гільдії: {guild['level']}\n"
        f"Учасники: {member_count}/{guild['member_limit']}\n\n"
        f"Місячний рейтинг ({season_key}):\n"
        f"• EXP: {guild['monthly_exp']}\n"
        f"• Ресурс: {guild['monthly_resource']}\n"
        f"• Вбивства: {guild['monthly_kills']}\n"
        f"• Контракти: {guild['monthly_contracts']}\n"
        f"• Score: {guild['monthly_score']}\n\n"
        f"За весь час:\n"
        f"• EXP: {guild['total_exp']}\n"
        f"• Ресурс: {guild['total_resource']}\n"
        f"• Score: {guild['total_score']}\n\n"
        "Доступні дії:\n"
        "• ℹ️ Інформація\n"
        "• 👥 Учасники\n"
        "• 📨 Заявки\n"
        "• 🏆 Рейтинг\n"
        "• 📜 Журнал"
    )


def build_guild_hall_text(user_id):
    init_guild_system()

    if get_user_guild(user_id):
        return build_guild_hall_member_text(user_id)

    return build_guild_hall_no_guild_text(user_id)


def build_guild_info_text(user_id):
    guild = get_user_guild(user_id)

    if not guild:
        return "❌ Ти не перебуваєш у гільдії."

    guild_name = get_guild_display_name(guild)
    member_count = get_guild_member_count(guild["id"])
    season_key = get_current_guild_season_key()

    return (
        f"ℹ️ Інформація про гільдію\n\n"
        f"{guild_name}\n"
        f"Голова user_id: {guild['leader_user_id']}\n"
        f"Рівень: {guild['level']}\n"
        f"Учасники: {member_count}/{guild['member_limit']}\n"
        f"Створено: {guild['created_at']}\n\n"
        f"Поточний сезон: {season_key}\n"
        f"Місячний score: {guild['monthly_score']}\n"
        f"All-time score: {guild['total_score']}"
    )


def build_guild_members_text(user_id):
    guild = get_user_guild(user_id)

    if not guild:
        return "❌ Ти не перебуваєш у гільдії."

    members = get_guild_members(guild["id"])
    guild_name = get_guild_display_name(guild)

    if not members:
        return f"👥 Учасники\n\n{guild_name}\n\nСписок учасників порожній."

    text = f"👥 Учасники\n\n{guild_name}\n\n"

    for index, member in enumerate(members, start=1):
        character_name = member["character_name"] or f"user_id={member['user_id']}"
        level = member["level"] or "?"
        role_label = get_guild_role_label(member["role"])
        score = member["contribution_score"] or 0
        monthly_score = member["monthly_contribution_score"] or 0

        text += (
            f"{index}. {role_label} {character_name}\n"
            f"   Рівень: {level} | Score: {score} | Місяць: {monthly_score}\n"
        )

    return text.strip()


def build_guild_ranking_text(scope="monthly"):
    init_guild_system()

    if scope == "total":
        title = "🏆 Рейтинг гільдій за весь час"
    else:
        title = f"🏆 Місячний рейтинг гільдій ({get_current_guild_season_key()})"

    rows = get_guild_ranking(scope=scope, limit=GUILD_RANKING_LIMIT)

    if not rows:
        return f"{title}\n\nПоки немає жодної гільдії."

    text = f"{title}\n\n"

    for index, guild in enumerate(rows, start=1):
        name = get_guild_display_name(guild)

        if scope == "total":
            score = guild["total_score"] or 0
            exp = guild["total_exp"] or 0
            resource = guild["total_resource"] or 0
        else:
            score = guild["monthly_score"] or 0
            exp = guild["monthly_exp"] or 0
            resource = guild["monthly_resource"] or 0

        text += (
            f"{index}. {name}\n"
            f"   Score: {score} | EXP: {exp} | Ресурс: {resource}\n"
        )

    return text.strip()


def build_guild_placeholder_text(title, next_stage):
    return (
        f"{title}\n\n"
        f"Цей розділ буде реалізовано на етапі {next_stage}.\n\n"
        "Ядро гільдій уже створене: таблиці, місячний рейтинг, all-time статистика та історія сезонів працюють."
    )


# ==============================
# KEYBOARDS
# ==============================

def guild_hall_kb(user_id):
    kb = types.InlineKeyboardMarkup(row_width=1)

    if get_user_guild(user_id):
        kb.add(types.InlineKeyboardButton(
            text="ℹ️ Інформація",
            callback_data="guild_info"
        ))
        kb.add(types.InlineKeyboardButton(
            text="👥 Учасники",
            callback_data="guild_members"
        ))
        kb.add(types.InlineKeyboardButton(
            text="📨 Заявки",
            callback_data="guild_applications"
        ))
        kb.add(types.InlineKeyboardButton(
            text="🏆 Місячний рейтинг",
            callback_data="guild_ranking:monthly"
        ))
        kb.add(types.InlineKeyboardButton(
            text="🏆 Рейтинг за весь час",
            callback_data="guild_ranking:total"
        ))
        kb.add(types.InlineKeyboardButton(
            text="📜 Журнал",
            callback_data="guild_logs"
        ))
    else:
        kb.add(types.InlineKeyboardButton(
            text="🏗️ Створити гільдію",
            callback_data="guild_create_start"
        ))
        kb.add(types.InlineKeyboardButton(
            text="📜 Переглянути гільдії",
            callback_data="guild_list"
        ))
        kb.add(types.InlineKeyboardButton(
            text="🏆 Місячний рейтинг",
            callback_data="guild_ranking:monthly"
        ))
        kb.add(types.InlineKeyboardButton(
            text="🏆 Рейтинг за весь час",
            callback_data="guild_ranking:total"
        ))
        kb.add(types.InlineKeyboardButton(
            text="📨 Мої заявки",
            callback_data="guild_my_applications"
        ))

    kb.add(types.InlineKeyboardButton(
        text="🔄 Оновити",
        callback_data="guild_hall_refresh"
    ))

    return kb


def guild_back_kb(user_id):
    kb = types.InlineKeyboardMarkup(row_width=1)
    kb.add(types.InlineKeyboardButton(
        text="🔙 До Зали Гільдій",
        callback_data="guild_hall_refresh"
    ))
    return kb


# ==============================
# SEND / EDIT
# ==============================

def send_or_edit(bot, chat_id, text, reply_markup=None, message_id=None):
    if message_id:
        try:
            bot.edit_message_text(
                chat_id=chat_id,
                message_id=message_id,
                text=text,
                reply_markup=reply_markup
            )
            return
        except Exception:
            pass

    bot.send_message(
        chat_id,
        text,
        reply_markup=reply_markup
    )


def open_guild_hall(bot, chat_id, user_id, message_id=None):
    text = build_guild_hall_text(user_id)
    kb = guild_hall_kb(user_id)

    send_or_edit(
        bot=bot,
        chat_id=chat_id,
        message_id=message_id,
        text=text,
        reply_markup=kb
    )


# ==============================
# HANDLERS
# ==============================

def register_guild_handlers(bot):
    init_guild_system()

    @bot.message_handler(func=lambda message: message.text == "🏰 Зала Гільдій")
    def guild_hall_message(message):
        open_guild_hall(
            bot=bot,
            chat_id=message.chat.id,
            user_id=message.from_user.id
        )

    @bot.callback_query_handler(func=lambda call: call.data == "guild_hall_refresh")
    def guild_hall_refresh_callback(call):
        bot.answer_callback_query(call.id)
        open_guild_hall(
            bot=bot,
            chat_id=call.message.chat.id,
            user_id=call.from_user.id,
            message_id=call.message.message_id
        )

    @bot.callback_query_handler(func=lambda call: call.data == "guild_info")
    def guild_info_callback(call):
        bot.answer_callback_query(call.id)
        send_or_edit(
            bot=bot,
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=build_guild_info_text(call.from_user.id),
            reply_markup=guild_back_kb(call.from_user.id)
        )

    @bot.callback_query_handler(func=lambda call: call.data == "guild_members")
    def guild_members_callback(call):
        bot.answer_callback_query(call.id)
        send_or_edit(
            bot=bot,
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=build_guild_members_text(call.from_user.id),
            reply_markup=guild_back_kb(call.from_user.id)
        )

    @bot.callback_query_handler(func=lambda call: call.data.startswith("guild_ranking:"))
    def guild_ranking_callback(call):
        scope = call.data.split(":", 1)[1]
        bot.answer_callback_query(call.id)
        send_or_edit(
            bot=bot,
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=build_guild_ranking_text(scope),
            reply_markup=guild_back_kb(call.from_user.id)
        )

    @bot.callback_query_handler(func=lambda call: call.data == "guild_create_start")
    def guild_create_start_callback(call):
        bot.answer_callback_query(call.id)
        send_or_edit(
            bot=bot,
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=build_guild_placeholder_text("🏗️ Створення гільдії", "7.0.3"),
            reply_markup=guild_back_kb(call.from_user.id)
        )

    @bot.callback_query_handler(func=lambda call: call.data == "guild_list")
    def guild_list_callback(call):
        bot.answer_callback_query(call.id)
        send_or_edit(
            bot=bot,
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=build_guild_placeholder_text("📜 Список гільдій", "7.0.4"),
            reply_markup=guild_back_kb(call.from_user.id)
        )

    @bot.callback_query_handler(func=lambda call: call.data == "guild_my_applications")
    def guild_my_applications_callback(call):
        bot.answer_callback_query(call.id)
        send_or_edit(
            bot=bot,
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=build_guild_placeholder_text("📨 Мої заявки", "7.0.4"),
            reply_markup=guild_back_kb(call.from_user.id)
        )

    @bot.callback_query_handler(func=lambda call: call.data == "guild_applications")
    def guild_applications_callback(call):
        bot.answer_callback_query(call.id)
        send_or_edit(
            bot=bot,
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=build_guild_placeholder_text("📨 Заявки до гільдії", "7.0.5"),
            reply_markup=guild_back_kb(call.from_user.id)
        )

    @bot.callback_query_handler(func=lambda call: call.data == "guild_logs")
    def guild_logs_callback(call):
        bot.answer_callback_query(call.id)
        send_or_edit(
            bot=bot,
            chat_id=call.message.chat.id,
            message_id=call.message.message_id,
            text=build_guild_placeholder_text("📜 Журнал гільдії", "7.0.8"),
            reply_markup=guild_back_kb(call.from_user.id)
        )
