#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Read-only audit of Equipment facade duplicates."""
from __future__ import annotations
import ast, inspect, sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path: sys.path.insert(0,str(ROOT))
REPORT=ROOT/"DB_CLEANUP_9_0_12I6A_EQUIPMENT_READONLY_DUPLICATES_AUDIT.md"
TARGETS=(
"ensure_equipment_slots","get_all_equipped_items","get_inventory_detailed",
"get_inventory_entry","get_item_by_inventory_id","get_item_by_inventory_id_full",
"get_item_bonuses","get_equipped_item_defenses","get_sellable_equipment_items",
"get_inventory_refine_level","get_inventory_refined_display_name","format_refined_item_name",
"init_weapon_damage_system","calculate_weapon_damage_by_values",
"get_weapon_damage_by_inventory_id","get_inventory_weapon_damage_display")

def fail(x): print("[FAIL] "+x); raise SystemExit(1)
def parse(path):
 text=path.read_text(encoding="utf-8-sig"); tree=ast.parse(text,filename=str(path)); d={}
 for n in tree.body:
  if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)): d.setdefault(n.name,[]).append(n)
 return text,d
def sig(fn):
 try:return str(inspect.signature(fn))
 except Exception as e:return f"<{e}>"
def safe(fn,*args):
 try:return True,fn(*args)
 except Exception as e:return False,f"{type(e).__name__}: {e}"
def main():
 dbtext,dbdefs=parse(ROOT/"db.py"); systext,sysdefs=parse(ROOT/"systems"/"equipment_system.py")
 import db
 from systems import equipment_system as eq
 rows=[]
 for name in TARGETS:
  dc=len(dbdefs.get(name,[])); sc=len(sysdefs.get(name,[]))
  if dc<2: fail(f"db.py {name}: expected duplicate, got {dc}")
  if sc<1: fail(f"equipment_system.py missing {name}")
  final_db=ast.get_source_segment(dbtext,dbdefs[name][-1]) or ""
  final_sys=ast.get_source_segment(systext,sysdefs[name][-1]) or ""
  if "equipment_system" not in final_db: fail(f"final db.{name} is not equipment_system wrapper")
  if "_call_legacy" in final_sys: fail(f"final equipment_system.{name} still calls _call_legacy")
  rows.append((name,dc,sc,[n.lineno for n in dbdefs[name]],sig(getattr(db,name)),sig(getattr(eq,name))))

 users=[int(r[0]) for r in db.cursor.execute("SELECT user_id FROM users ORDER BY user_id").fetchall()]
 comparisons=0
 # Safe, read-only public/system equivalence on current fixtures.
 for uid in users:
  for name in ("get_all_equipped_items","get_inventory_detailed","get_item_bonuses","get_equipped_item_defenses","get_sellable_equipment_items"):
   if safe(getattr(db,name),uid)!=safe(getattr(eq,name),uid): fail(f"user comparison mismatch {name}, user={uid}")
   comparisons+=1
  inv=db.cursor.execute("SELECT id FROM inventory WHERE user_id=? ORDER BY id LIMIT 20",(uid,)).fetchall()
  for (iid,) in inv:
   for name in ("get_inventory_entry","get_item_by_inventory_id","get_item_by_inventory_id_full","get_inventory_refine_level","get_inventory_refined_display_name","get_weapon_damage_by_inventory_id","get_inventory_weapon_damage_display"):
    if safe(getattr(db,name),iid)!=safe(getattr(eq,name),iid): fail(f"item comparison mismatch {name}, inventory={iid}")
    comparisons+=1

 # Pure calculation/display APIs.
 pure_cases=(("calculate_weapon_damage_by_values",(8,12,1,"common")),("format_refined_item_name",("Item",3)))
 pure=0
 for name,args in pure_cases:
  if safe(getattr(db,name),*args)!=safe(getattr(eq,name),*args): fail(f"pure mismatch {name}")
  pure+=1

 report=["# ROM 9.0.12i6a - Equipment Read-only Duplicates Audit","","## Scope","","Read-only audit. No gameplay code or database rows were changed.","","## Cleanup candidates",""]
 for name,dc,sc,lines,ds,ss in rows:
  report.append(f"- `{name}`: db definitions={dc}, db lines={lines}, system definitions={sc}, public signature=`{ds}`, final system signature=`{ss}`")
 report += ["","## Runtime","",f"- Public/system read-only comparisons: {comparisons}",f"- Pure API comparisons: {pure}","- Mismatches: 0","- Final system implementations using `_call_legacy`: 0","- Database mutations: 0","","## Recommendation","","Proceed to 9.0.12i6b. Remove all earlier db.py definitions for these 16 APIs, preserve only final facade wrappers, and rerun the existing equipment readonly, inventory/refine, weapon-damage, trader, player-stat, core, and import tests.",""]
 REPORT.write_text("\n".join(report),encoding="utf-8")
 print("[OK] equipment read-only duplicates audit")
 print(f"- duplicate cleanup candidates: {len(TARGETS)}")
 print(f"- public/system comparisons: {comparisons}")
 print(f"- pure API comparisons: {pure}")
 print("- mismatches: 0")
 print("- final system legacy delegation: 0")
 print("- database mutations: 0")
 print(f"- report: {REPORT}")
if __name__=="__main__": main()
