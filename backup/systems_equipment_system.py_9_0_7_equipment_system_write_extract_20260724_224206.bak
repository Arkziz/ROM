    return _call_legacy('get_inventory_detailed', *args, **kwargs)

def get_inventory_entry(*args, **kwargs):
    return _call_legacy('get_inventory_entry', *args, **kwargs)

def get_item_by_inventory_id(*args, **kwargs):
    return _call_legacy('get_item_by_inventory_id', *args, **kwargs)

def get_item_by_inventory_id_full(*args, **kwargs):
    return _call_legacy('get_item_by_inventory_id_full', *args, **kwargs)

def get_item_bonuses(*args, **kwargs):
    return _call_legacy('get_item_bonuses', *args, **kwargs)

def get_equipped_item_defenses(*args, **kwargs):
    return _call_legacy('get_equipped_item_defenses', *args, **kwargs)

def get_sellable_equipment_items(*args, **kwargs):
    return _call_legacy('get_sellable_equipment_items', *args, **kwargs)

def init_weapon_damage_system(*args, **kwargs):
    return _call_legacy('init_weapon_damage_system', *args, **kwargs)

def calculate_weapon_damage_by_values(*args, **kwargs):
    return _call_legacy('calculate_weapon_damage_by_values', *args, **kwargs)

